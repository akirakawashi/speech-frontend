# Значения по умолчанию и что они означают — в README.
# Для локальной разработки скопируй в `.env.local` и поправь адрес API.
SPEECH_AUTH_MODE=open
SPEECH_API_URL=
# Куда `/api/*` пробрасывает сам фронт (обработчик `app/api`), читается в
# момент запроса. Локально — `speech-ms`, поднятый рядом; в контейнере —
# `http://speech-ms:8096` (задаёт docker-compose.yml бэкенда).
SPEECH_API_PROXY_TARGET=http://127.0.0.1:18096
SPEECH_DISPLAY_TIMEZONE=Europe/Moscow
